# Copy this file to .env.local to change the defaults.

# Base URL of the backend API, as seen by the app (default: /api).
# A path like /api is forwarded to API_PROXY_TARGET, by the dev server and by the packaged Electron app.
# A full URL (e.g. http://localhost:3000) is called directly: the backend must then allow CORS,
# and the Content-Security-Policy of index.html must allow its origin (connect-src and img-src).
VITE_API_URL=/api

# Where /api/* requests are forwarded (default: http://127.0.0.1:3000):
# by the dev server, and by the packaged Electron app (set when building it).
# Prefer 127.0.0.1 to localhost, which Node may resolve to IPv6 (::1).
API_PROXY_TARGET=http://127.0.0.1:3000
